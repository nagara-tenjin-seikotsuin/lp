---
import { Picture } from "astro:assets";

const CV_LINK = 'https://airrsv.net/nagara-tenjin-seikotsuin/calendar';

interface Props {
  position: string;
}

const { position } = Astro.props;
---

<a
  href={CV_LINK}
  target="_blank"
  rel="noopener noreferrer"
  class="flex justify-center"
  data-position={position}
  onclick="gtag('event', 'cv_click', { cv_position: this.dataset.position })"
>
  <Picture
    src={import("@/assets/cv-button.png")}
    formats={["avif", "webp"]}
    alt="cv button"
  />
</a>
